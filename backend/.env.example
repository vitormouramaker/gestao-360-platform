# Modelo do .env. Copie para .env e ajuste. O .env nunca vai para o git.
# Os valores abaixo já funcionam com o docker-compose da raiz do repositório.

PORT=4460

DB_USER=postgres
DB_HOST=localhost
DB_NAME=gestao_360
DB_PASSWORD=postgres
DB_PORT=5432

# SMTP opcional. Vazio = os e-mails não saem da máquina: assunto e links
# (criar senha, recuperar senha) são impressos no console do back.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Endereco do front (links de e-mail e CORS).
FRONTEND_URL=http://localhost:5180

# Autenticacao (tokens JWT). Minimo de 32 caracteres cada. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Os valores abaixo servem SÓ para rodar localmente.
JWT_SECRET=troque-este-segredo-local-de-desenvolvimento-0001
JWT_REFRESH_SECRET=troque-este-segredo-local-de-desenvolvimento-0002

# Checkout do plano Premium (botao "comprar" do modal de upgrade). Opcional.
PREMIUM_CHECKOUT_URL=

# Hubla (plataforma de pagamento). O webhook fica em /api/hubla/webhook; o
# token e o da regra criada no painel (cabecalho x-hubla-token). Vazio = o
# endereco recusa tudo. Os ids das ofertas dizem qual plano cada compra libera.
HUBLA_WEBHOOK_TOKEN=
HUBLA_OFFER_ESSENCIAL=
HUBLA_OFFER_PREMIUM=

# IA (rascunho do diagnostico/plano e assistente de suporte). Sem a chave, a
# plataforma funciona igual e a equipe escreve os planos no editor.
# Confira com: node scripts/testar-ia.js
ANTHROPIC_API_KEY=
# So para chave que nao e presa a um workspace (a API pede o ID do workspace).
ANTHROPIC_WORKSPACE_ID=
# Opcional: troca o modelo do plano (padrao claude-sonnet-5-5) e o do
# suporte (padrao claude-haiku-5-5).
AGENT_MODEL=
SUPPORT_MODEL=

# Plataformas externas incluidas no programa. Cada uma so e chamada quando o
# endereco do back dela e a chave da integracao estao preenchidos; sem isso o
# acesso fica "na fila" e nada e enviado.
ACADEMY_INTEGRATION_URL=
ACADEMY_INTEGRATION_KEY=
FORMACAO_EXECUTIVA_INTEGRATION_URL=
FORMACAO_EXECUTIVA_INTEGRATION_KEY=
CRM_INTEGRATION_URL=
CRM_INTEGRATION_KEY=

# Sistema de credenciamento (leitura do QR code na porta dos eventos). Com
# endereco e chave, o ingresso e registrado la e o QR sai no formato que o
# leitor dele ja le. Sem isso, vale a conferencia do proprio /adm.
CREDENCIAMENTO_INTEGRATION_URL=
CREDENCIAMENTO_INTEGRATION_KEY=
# Endereco do site do credenciamento que vai dentro do QR code.
CREDENCIAMENTO_QR_BASE=https://credenciamento.example.com
